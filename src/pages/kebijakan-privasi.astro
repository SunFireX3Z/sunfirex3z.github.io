---
import StaticPageLayout from '@/layouts/StaticPageLayout.astro';
import { Content, getHeadings } from '@/content/privacy-policy.mdx';

const pageTitle = "Kebijakan Privasi";
const pageDescription =
    "Pelajari bagaimana SunBlog mengumpulkan, menggunakan, dan melindungi informasi yang diproses saat Anda mengunjungi website ini.";
---

<StaticPageLayout title={pageTitle} description={pageDescription} headings={getHeadings()}>
    <Content />
</StaticPageLayout>