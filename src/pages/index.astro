---
import Layout from '@/layouts/Layout.astro';
import Card from '@/components/article/Card.astro';
import ProjectCard from '@/components/proyek/ProjectCard.astro';
import FeaturedCard from '@/components/article/FeaturedCard.astro';
import { Image } from 'astro:assets'; // Import Image component
import heroBannerBg from '@/assets/images/hero-banner-bg.webp';
import { posts, latestPost, featuredPosts, recentPosts } from '@/data/posts';
import { authors } from '@/data/authors';

// Ambil data proyek
const projectModules = await import.meta.glob('../content/proyek/**/*.mdx', { eager: true });
const projects = Object.values(projectModules)
    .filter(module => module && module.metadata && module.metadata.visibility !== 'hidden') // Sembunyikan proyek dengan visibility 'hidden'
    .map(module => {
        const { metadata } = module;
        const slug = module.file
            .replace(/.*\/src\/content\/proyek\//, '')
            .replace('.mdx', '');
        return { ...metadata, path: `/proyek/${slug}` };
    })
    .sort((a, b) => new Date(b.startDate) - new Date(a.startDate));

// Ambil 3 proyek terbaru
const recentProjectsList = projects.slice(0, 3);

---

<Layout 
    title="Beranda" 
    description="Menjelajahi dunia teknologi, desain, dan pengembangan web melalui tulisan dan proyek."
>
    <!-- Hero Section: Full-width and full-height -->
    <section class="relative flex min-h-[60vh] md:min-h-[65vh] items-center justify-center bg-slate-900 py-16">
        <div class="absolute inset-0">
            {/* Background Image */}
            <Image 
                src={heroBannerBg} 
                alt="Abstract background banner" 
                class="h-full w-full object-cover opacity-10"
                width={1600} height={900} format="webp" quality={50}
            />
            <div class="absolute inset-0 bg-gradient-to-r from-slate-900/60 to-slate-900/10"></div>
        </div>

        <!-- Konten Hero tetap berada di tengah secara vertikal -->
        <div class="relative z-10 w-full max-w-3xl px-6 text-center">
            <h1 class="text-4xl font-bold leading-tight tracking-tight text-white lg:text-5xl hero-title">SunBlog: Blog Pribadi & Portofolio</h1>
            <p class="mx-auto mt-4 text-lg text-slate-300">Menjelajahi dunia teknologi, desain, dan pengembangan web melalui tulisan dan proyek.</p>
            <div class="mt-8">
                <a href="/blog" class="inline-block rounded-lg bg-orange-600 px-8 py-4 text-lg font-bold text-white shadow-lg transition-all duration-300 hover:scale-105 hover:bg-orange-700 focus:outline-none focus:ring-4 focus:ring-orange-300">Jelajahi Blog</a>
            </div>

            <!-- Author Marquee -->
            <div class="relative mt-12 w-full max-w-2xl mx-auto overflow-hidden mask-gradient-horizontal">
                <div class="flex">
                    <div class="flex flex-shrink-0 animate-marquee-horizontal">
                        {Object.values(authors).map(author => (
                            <div class="flex items-center gap-4 mx-6 whitespace-nowrap">
                                {author.avatar && (
                                    <Image src={author.avatar} alt={`Avatar of ${author.fullName}`} class="h-10 w-10 rounded-full object-cover ring-2 ring-white/20" width={40} height={40} format="webp" quality={80} />
                                )}
                                <div class="text-left">
                                    <p class="font-bold text-base text-white">{author.fullName}</p>
                                    <p class="text-sm text-slate-400">{author.role}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                    <div class="flex flex-shrink-0 animate-marquee-horizontal" aria-hidden="true">
                        {Object.values(authors).map(author => (
                            <div class="flex items-center gap-4 mx-6 whitespace-nowrap">
                                {author.avatar && (
                                    <Image src={author.avatar} alt={`Avatar of ${author.name}`} class="h-10 w-10 rounded-full object-cover ring-2 ring-white/20" width={40} height={40} format="webp" quality={80} />
                                )}
                                <div class="text-left">
                                    <p class="font-bold text-base text-white">{author.name}</p>
                                    <p class="text-sm text-slate-400">{author.role}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Konten sisa halaman dibungkus dalam container sendiri dengan margin atas -->
    <div class="mx-auto w-full max-w-[90rem] px-6 py-16 space-y-16">
        {/* Bagian Atas: Latest & Featured */}
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
            {/* Artikel Terbaru */}
            <div class="lg:col-span-1 flex flex-col">
                <h2 class="mb-4 inline-block border-b-4 border-orange-500 pb-1 text-3xl font-bold">
                    Terbaru
                </h2>

                {latestPost && (
                    <div class="flex-1">
                        <Card {...latestPost.metadata} path={latestPost.path} isLarge />
                    </div>
                )}
            </div>

            {/* Pilihan Editor */}
            <div class="lg:col-span-1 flex flex-col">
                <h2 class="mb-4 inline-block border-b-4 border-orange-500 pb-1 text-3xl font-bold">
                    Pilihan Editor
                </h2>

                <div class="flex flex-1 flex-col justify-between rounded-xl bg-white p-4 shadow-md">
                    {featuredPosts.map(post => (
                        <FeaturedCard {...post.metadata} path={post.path} />
                    ))}
                </div>
            </div>
        </section>

        {/* Bagian Bawah: Blog Terbaru */}
        <section class="mt-16">
            <h2 class="mb-4 inline-block border-b-4 border-orange-500 pb-1 text-2xl font-bold sm:text-3xl">Artikel Terbaru Lainnya</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {recentPosts.map(post => (<Card {...post.metadata} path={post.path} />))}
            </div>
        </section>

        {/* Bagian Proyek Terbaru */}
        {recentProjectsList.length > 0 && (
            <section class="mt-16">
                <div class="mb-6 flex items-center justify-between">
                    <h2 class="mb-4 inline-block border-b-4 border-orange-500 pb-1 text-2xl font-bold sm:text-3xl">Proyek Terbaru</h2>
                    <a href="/proyek" class="font-semibold text-orange-600 transition-colors hover:text-orange-700 hover:underline">Lihat Semua Proyek &rarr;</a>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {recentProjectsList.map(project => (
                        <a href={project.path} class="block h-full"><ProjectCard {...project} /></a>
                    ))}
                </div>
            </section>
        )}
    </div>
</Layout>

<style>
    .mask-gradient-horizontal {
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
        mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
    }

    .animate-marquee-horizontal {
        animation: marquee-horizontal 60s linear infinite;
    }

    @keyframes marquee-horizontal {
        from {
            transform: translateX(0%);
        }
        to {
            transform: translateX(-100%);
        }
    }
</style>
