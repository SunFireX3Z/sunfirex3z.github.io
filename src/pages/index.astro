---
import Layout from '@/layouts/Layout.astro';
import Card from '@/components/article/Card.astro';
import ProjectCard from '@/components/proyek/ProjectCard.astro';
import FeaturedCard from '@/components/article/FeaturedCard.astro';
import { latestPost, featuredPosts, recentPosts } from '@/data/posts';

// Ambil data proyek
const projectModules = await import.meta.glob('../content/proyek/**/*.mdx', { eager: true });
const projects = Object.values(projectModules)
    .filter(module => module && module.metadata && module.metadata.visibility !== 'hidden') // Sembunyikan proyek dengan visibility 'hidden'
    .map(module => {
        const { metadata } = module;
        const slug = module.file
            .replace(/.*\/src\/content\/proyek\//, '')
            .replace('.mdx', '');
        return { ...metadata, path: `/proyek/${slug}` };
    })
    .sort((a, b) => new Date(b.startDate) - new Date(a.startDate));

// Ambil 3 proyek terbaru
const recentProjectsList = projects.slice(0, 3);
---

<Layout 
	title="Beranda" 
	description="Menjelajahi dunia teknologi, desain, dan pengembangan web melalui tulisan dan proyek."
>
    <div class="space-y-16">
        {/* Judul Halaman */}
        <section class="text-center">
            <h1 class="text-4xl font-bold tracking-tight lg:text-5xl hero-title">
                SunBlog: Blog Pribadi & Portofolio
            </h1>
            <p class="mt-4 max-w-2xl text-lg text-gray-600 mx-auto">
                Menjelajahi dunia teknologi, desain, dan pengembangan web melalui tulisan dan proyek.
            </p>
        </section>

        {/* Bagian Atas: Latest & Featured */}
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
            {/* Latest Blog */}
            <div class="lg:col-span-1 flex flex-col">
                <h2 class="mb-4 inline-block border-b-4 border-orange-500 pb-1 text-3xl font-bold">
                    Terbaru
                </h2>

                {latestPost && (
                    <div class="flex-1">
                        <Card {...latestPost.metadata} path={latestPost.path} isLarge />
                    </div>
                )}
            </div>

            {/* Featured Blog */}
            <div class="lg:col-span-1 flex flex-col">
                <h2 class="mb-4 inline-block border-b-4 border-orange-500 pb-1 text-3xl font-bold">
                    Pilihan Editor
                </h2>

                <div class="flex flex-1 flex-col justify-between rounded-xl bg-white p-4 shadow-md">
                    {featuredPosts.map(post => (
                        <FeaturedCard {...post.metadata} path={post.path} />
                    ))}
                </div>
            </div>
        </section>

        {/* Bagian Bawah: Blog Terbaru */}
        <section>
            <h2 class="text-3xl font-bold mb-4 border-b-4 border-orange-500 inline-block pb-1">Artikel Terbaru Lainnya</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {recentPosts.map(post => (<Card {...post.metadata} path={post.path} />))}
            </div>
        </section>

        {/* Bagian Proyek Terbaru */}
        {recentProjectsList.length > 0 && (
            <section>
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-3xl font-bold border-b-4 border-orange-500 inline-block pb-1">Proyek Terbaru</h2>
                    <a href="/proyek" class="font-semibold text-orange-600 transition-colors hover:text-orange-700 hover:underline">Lihat Semua Proyek &rarr;</a>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {recentProjectsList.map(project => (
                        <a href={project.path} class="block h-full"><ProjectCard {...project} /></a>
                    ))}
                </div>
            </section>
        )}
    </div>
</Layout>
