---
import Layout from '@/layouts/Layout.astro';
import ProjectCard from '@/components/proyek/ProjectCard.astro';
import CategoryNavLink from '@/components/article/CategoryNavLink.astro';

const projectModules = await import.meta.glob('../../content/proyek/**/*.mdx', { eager: true });

const allProjects = Object.values(projectModules)
    .filter(module => module && module.metadata && module.metadata.visibility !== 'hidden') // Sembunyikan proyek dengan visibility 'hidden'
    .map(module => {
        const slug = module.file
            .replace(/.*\/src\/content\/proyek\//, '')
            .replace('.mdx', '');
        return {
            ...module.metadata,
            path: `/proyek/${slug}`,
        };
    })
    .sort((a, b) => new Date(b.startDate) - new Date(a.startDate));

// Get unique categories and their counts
const totalProjectCount = allProjects.length;
const categoryCounts = allProjects.reduce((acc, project) => {
    if (project.category) {
        acc[project.category] = (acc[project.category] || 0) + 1;
    }
    return acc;
}, {});

const categoriesWithCounts = [
    { name: 'Semua', count: totalProjectCount, path: '/proyek' },
    ...Object.entries(categoryCounts).map(([name, count]) => ({
        name,
        count,
        path: `/proyek/kategori/${name.toLowerCase().replace(/\s+/g, '-')}`
    }))
];

const pageTitle = "Proyek Saya";
const pageDescription = "Kumpulan proyek yang pernah saya kerjakan, mulai dari aplikasi web, situs statis, hingga eksperimen teknologi lainnya.";
const currentPath = Astro.url.pathname;
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="mx-auto w-full max-w-[90rem] px-6 py-16 space-y-12">
        <section class="border-l-4 border-orange-500 pl-4">
            <h1 class="text-4xl font-bold tracking-tight lg:text-5xl">{pageTitle}</h1>
            <p class="mt-4 max-w-2xl text-lg text-gray-600">{pageDescription}</p>
        </section>

        <!-- Filter Kategori Proyek -->
        <nav class="flex gap-3 overflow-x-auto pb-4 horizontal-scrollbar">
            {categoriesWithCounts.map(cat => (
                <CategoryNavLink href={cat.path} currentPath={currentPath} text={cat.name} count={cat.count} class="flex-shrink-0" />
            ))}
        </nav>

        <section>
            {allProjects.length > 0 ? (
                <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                    {allProjects.map(project => (
                        <a href={project.path} class="block h-full">
                            <ProjectCard {...project} />
                        </a>
                    ))}
                </div>
            ) : (
                <div class="text-center py-16">
                    <h2 class="text-2xl font-bold text-gray-700">Belum Ada Proyek</h2>
                    <p class="mt-2 text-gray-500">Halaman ini akan segera diisi dengan proyek-proyek menarik.</p>
                </div>
            )}
        </section>
    </div>
</Layout>