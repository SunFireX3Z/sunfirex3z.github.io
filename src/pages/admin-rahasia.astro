---
import Layout from '@/layouts/Layout.astro';
import PostCreatorForm from '@/components/admin/PostCreatorForm.jsx';

// PENTING: Halaman ini hanya untuk development.
// Arahkan ke 404 jika diakses di production.
if (import.meta.env.PROD) {
    return Astro.redirect('/404');
}
---
<Layout title="Admin - Buat Artikel Baru">
    <div class="bg-slate-100 py-16 min-h-screen">
        <PostCreatorForm client:load />
    </div>
</Layout>