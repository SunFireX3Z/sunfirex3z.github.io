---
import StaticPageLayout from '@/layouts/StaticPageLayout.astro';
import { Content, getHeadings } from '@/content/copyright.mdx';

const pageTitle = "Hak Cipta";
const pageDescription =
    "Informasi mengenai kebijakan hak cipta, kepemilikan, dan panduan penggunaan konten yang diterbitkan di SunBlog.";
---

<StaticPageLayout title={pageTitle} description={pageDescription} headings={getHeadings()}>
    <Content />
</StaticPageLayout>