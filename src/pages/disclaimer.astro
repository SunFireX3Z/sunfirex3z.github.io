---
import Layout from '@/layouts/Layout.astro';
import { Content, getHeadings } from '@/content/disclaimer.mdx';

const pageTitle = "Disclaimer";
const pageDescription =
    "Halaman disclaimer ini menjelaskan batasan tanggung jawab terkait informasi yang disajikan di SunBlog.";

// Panggil fungsi getHeadings() untuk mendapatkan array headings
const headings = getHeadings();
// Ambil semua heading level 2 (##) dari file MDX untuk dijadikan Daftar Isi
const toc = (headings ?? []).filter(heading => heading.depth === 2);
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="mx-auto w-full max-w-[90rem] px-6 py-16">

        <!-- Hero -->
        <header class="mx-auto max-w-7xl border-l-4 border-orange-500 pl-4">
            <h1 class="text-4xl font-bold tracking-tight text-gray-900 lg:text-5xl">
                {pageTitle}
            </h1>

            <p class="mt-4 text-lg leading-8 text-gray-600">
                {pageDescription}
            </p>
        </header>

        <!-- Content -->
        <div class="mx-auto mt-14 grid max-w-7xl gap-12 lg:grid-cols-[240px_minmax(0,1fr)]">

            <!-- TOC -->
            <aside class="hidden lg:block">
                <div class="sticky top-28 rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
                    <h2 class="mb-4 text-sm font-bold uppercase tracking-wide text-gray-900">
                        Daftar Isi
                    </h2>

                    <nav>
                        <ul class="space-y-2">
                            {toc.map((heading) => (
                                <li>
                                    <a
                                        href={`#${heading.slug}`}
                                        class="block rounded-md px-3 py-2 text-sm text-gray-600 transition hover:bg-orange-50 hover:text-orange-600"
                                    >
                                        {heading.text}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                </div>
            </aside>

            <!-- Article -->
            <main class="min-w-0">
                <article class="prose prose-lg max-w-none prose-headings:scroll-mt-40">
                    <Content />
                </article>
            </main>

        </div>

    </div>
</Layout>