---
import StaticPageLayout from '@/layouts/StaticPageLayout.astro';
import { Content, getHeadings } from '@/content/disclaimer.mdx';

const pageTitle = "Disclaimer";
const pageDescription =
    "Halaman disclaimer ini menjelaskan batasan tanggung jawab terkait informasi yang disajikan di SunBlog.";
---

<StaticPageLayout title={pageTitle} description={pageDescription} headings={getHeadings()}>
    <Content />
</StaticPageLayout>