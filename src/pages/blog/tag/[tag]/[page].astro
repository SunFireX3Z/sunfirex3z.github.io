---
import BlogPageLayout from "@/layouts/BlogPageLayout.astro";
import { posts } from "@/data/posts";

export function getStaticPaths() {
  const PAGE_SIZE = 12;
  const allTags = [...new Set(posts.flatMap((post) => post.metadata.tags ?? []))];
  const paths = [];

  for (const tag of allTags) {
    const tagSlug = tag.toLowerCase().replace(/\s+/g, "-");
    const filteredPosts = posts.filter((post) =>
      post.metadata.tags?.some((t) => t.toLowerCase().replace(/\s+/g, "-") === tagSlug)
    );
    const lastPage = Math.ceil(filteredPosts.length / PAGE_SIZE);

    // Hanya halaman 2 ke atas
    for (let p = 2; p <= lastPage; p++) {
      paths.push({ params: { tag: tagSlug, page: String(p) } });
    }
  }
  return paths;
}

const PAGE_SIZE = 12;
const { tag = "", page: pageParam } = Astro.params;
const currentPage = Number(pageParam);

const filteredPosts = posts.filter((post) =>
  post.metadata.tags?.some((t) => t.toLowerCase().replace(/\s+/g, "-") === tag)
);
const lastPage = Math.ceil(filteredPosts.length / PAGE_SIZE);
const pageData = filteredPosts.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

const formattedTag = tag.replace(/-/g, " ").replace(/\b\w/g, (char) => char.toUpperCase());

const pageTitle = `Tag: #${formattedTag} (Halaman ${currentPage})`;
const pageDescription = `Menjelajahi semua artikel dengan tag #${formattedTag}.`;

const page = {
  data: pageData,
  currentPage,
  lastPage,
  url: {
    current: `/blog/tag/${tag}/${currentPage}`,
    prev: currentPage === 2 ? `/blog/tag/${tag}` : `/blog/tag/${tag}/${currentPage - 1}`,
    next: currentPage < lastPage ? `/blog/tag/${tag}/${currentPage + 1}` : undefined,
  },
};
---

<BlogPageLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  filteredPosts={page.data}
  page={page}
/>
