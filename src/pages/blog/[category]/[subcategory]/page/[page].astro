---
import BlogPageLayout from "@/layouts/BlogPageLayout.astro";
import { posts } from "@/data/posts";

export function getStaticPaths() {
  const PAGE_SIZE = 12;
  const uniqueSubcategories = [
    ...new Map(
      posts
        .filter((post) => post.metadata.subcategory)
        .map((post) => [
          `${post.category.toLowerCase().replace(/\s+/g, "-")}/${post.metadata.subcategory.toLowerCase().replace(/\s+/g, "-")}`,
          {
            category: post.category.toLowerCase().replace(/\s+/g, "-"),
            subcategory: post.metadata.subcategory.toLowerCase().replace(/\s+/g, "-"),
          },
        ])
    ).values(),
  ];

  const paths = [];
  for (const { category, subcategory } of uniqueSubcategories) {
    const filteredPosts = posts.filter(
      (post) =>
        post.category.toLowerCase().replace(/\s+/g, "-") === category &&
        post.metadata.subcategory?.toLowerCase().replace(/\s+/g, "-") === subcategory
    );
    const lastPage = Math.ceil(filteredPosts.length / PAGE_SIZE);

    // Hanya halaman 2 ke atas
    for (let p = 2; p <= lastPage; p++) {
      paths.push({ params: { category, subcategory, page: String(p) } });
    }
  }
  return paths;
}

const PAGE_SIZE = 12;
const { category = "", subcategory = "", page: pageParam } = Astro.params;
const currentPage = Number(pageParam);

const filteredPosts = posts.filter(
  (post) =>
    post.category.toLowerCase().replace(/\s+/g, "-") === category &&
    post.metadata.subcategory?.toLowerCase().replace(/\s+/g, "-") === subcategory
);
const lastPage = Math.ceil(filteredPosts.length / PAGE_SIZE);
const pageData = filteredPosts.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

const formattedSubcategory = subcategory
  .replace(/-/g, " ")
  .replace(/\b\w/g, (char) => char.toUpperCase());

const pageTitle = `Subkategori: ${formattedSubcategory} (Halaman ${currentPage})`;
const pageDescription = `Menjelajahi semua artikel dalam subkategori ${formattedSubcategory}.`;

const page = {
  data: pageData,
  currentPage,
  lastPage,
  url: {
    current: `/blog/${category}/${subcategory}/page/${currentPage}`,
    prev: currentPage > 1 ? (currentPage === 2 ? `/blog/${category}/${subcategory}` : `/blog/${category}/${subcategory}/page/${currentPage - 1}`) : undefined,
    next: currentPage < lastPage ? `/blog/${category}/${subcategory}/page/${currentPage + 1}` : undefined,
  },
};
---

<BlogPageLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  filteredPosts={page.data}
  page={page}
/>