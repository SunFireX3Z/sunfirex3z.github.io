---
import BlogPageLayout from "@/layouts/BlogPageLayout.astro";
import { posts } from "@/data/posts";

export function getStaticPaths() {
  const PAGE_SIZE = 12;
  const uniqueCategories = [...new Set(posts.map((post) => post.category))];
  return uniqueCategories.map((category) => ({
    params: { category: category.toLowerCase().replace(/\s+/g, "-") },
  }));
}

const PAGE_SIZE = 12;
const { category = "" } = Astro.params;

const filteredPosts = posts.filter(
  (post) => post.category.toLowerCase().replace(/\s+/g, "-") === category
);

const currentPage = 1;
const lastPage = Math.ceil(filteredPosts.length / PAGE_SIZE);
const pageData = filteredPosts.slice(0, PAGE_SIZE);

const formattedCategory = category
  .replace(/-/g, " ")
  .replace(/\b\w/g, (char) => char.toUpperCase());

const pageTitle = `Kategori: ${formattedCategory}`;
const pageDescription = `Menjelajahi semua artikel dalam kategori ${formattedCategory}.`;

const page = {
  data: pageData,
  currentPage,
  lastPage,
  url: {
    current: `/blog/${category}`,
    prev: undefined,
    next: lastPage > 1 ? `/blog/${category}/2` : undefined,
  },
};
---

<BlogPageLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  filteredPosts={page.data}
  page={page}
/>