---
import Layout from '@/layouts/Layout.astro';
import { posts } from '@/data/posts';

const pageTitle = "Arsip Blog";
const pageDescription = "Jelajahi semua artikel yang pernah dipublikasikan di SunBlog, diurutkan berdasarkan tahun dan bulan.";

// Kelompokkan postingan berdasarkan tahun, lalu bulan.
const groupedPosts = posts.reduce((acc, post) => {
    const date = new Date(post.metadata.publishDate);
    const year = date.getFullYear();
    const month = date.toLocaleString('id-ID', { month: 'long' });

    if (!acc[year]) acc[year] = {};
    if (!acc[year][month]) acc[year][month] = [];

    acc[year][month].push(post);
    return acc;
}, {});

// Urutkan tahun dari yang terbaru ke yang terlama.
const sortedYears = Object.keys(groupedPosts).sort((a, b) => Number(b) - Number(a));
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="mx-auto w-full max-w-[90rem] px-6 py-16 space-y-16">
        <section class="border-l-4 border-orange-500 pl-4">
            <h1 class="text-4xl font-bold tracking-tight lg:text-5xl">{pageTitle}</h1>
            <p class="mt-4 max-w-2xl text-lg text-gray-600">{pageDescription}</p>
        </section>

        <section class="space-y-12">
            {sortedYears.map(year => (
                <div class="relative">
                    <h2 class="sticky top-24 z-8 -ml-4 inline-block rounded-r-lg bg-orange-500 px-4 py-2 text-2xl font-bold text-white shadow-md lg:top-40">
                        {year}
                    </h2>
                    <div class="mt-6 space-y-8 border-l-2 border-gray-200 pl-8">
                        {Object.keys(groupedPosts[year]).map(month => (
                            <div class="relative">
                                <div class="absolute -left-[3.0rem] top-1.5 h-3 w-3 rounded-full bg-gray-300 ring-8 ring-white"></div>
                                <h3 class="text-xl font-bold text-gray-800">{month}</h3>
                                <ul class="mt-4 space-y-4">
                                    {groupedPosts[year][month].map(post => (<li><a href={post.path} class="group flex items-start gap-4"><time datetime={post.metadata.publishDate} class="w-24 flex-shrink-0 text-sm font-semibold text-gray-500">{new Date(post.metadata.publishDate).toLocaleDateString('id-ID', { day: '2-digit', month: 'short' })}</time><div class="flex-1"><p class="font-bold text-gray-900 group-hover:text-orange-600 line-clamp-2">{post.metadata.title}</p><p class="text-xs text-gray-400">oleh {post.metadata.author}</p></div></a></li>))}
                                </ul>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </section>
    </div>
</Layout>