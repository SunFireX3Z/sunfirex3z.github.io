---
import BlogPageLayout from '@/layouts/BlogPageLayout.astro';
import { posts } from '@/data/posts';

export async function getStaticPaths({ paginate }) {
  // Mengatur 12 postingan per halaman
  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props;

const pageTitle = page.currentPage > 1 ? `Semua Postingan (Halaman ${page.currentPage})` : 'Semua Postingan';
const pageDescription = 'Jelajahi semua artikel, tutorial, dan pemikiran yang telah saya bagikan di sini.';
---
<BlogPageLayout
    pageTitle={pageTitle}
    pageDescription={pageDescription}
    filteredPosts={page.data}
    page={page}
/>