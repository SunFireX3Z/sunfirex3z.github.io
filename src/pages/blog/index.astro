---
import BlogPageLayout from '@/layouts/BlogPageLayout.astro';
import { posts } from '@/data/posts';

const PAGE_SIZE = 12;
const currentPage = 1;
const lastPage = Math.ceil(posts.length / PAGE_SIZE);
const pageData = posts.slice(0, PAGE_SIZE);

const pageTitle = 'Semua Postingan';
const pageDescription = 'Jelajahi semua artikel, tutorial, dan pemikiran yang telah saya bagikan di sini.';

// Buat objek `page` secara manual agar kompatibel dengan Pagination component
const page = {
    data: pageData,
    currentPage,
    lastPage,
    url: {
        current: '/blog',
        prev: undefined,
        next: lastPage > 1 ? '/blog/2' : undefined,
    },
};
---
<BlogPageLayout
    pageTitle={pageTitle}
    pageDescription={pageDescription}
    filteredPosts={page.data}
    page={page}
/>
