---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import { posts } from '@/data/posts';
import TableOfContents from '@/components/article/TableOfContents.jsx';
import ShareButton from '@/components/article/ShareButton.jsx';
import RelatedPostCard from '@/components/article/RelatedPostCard.astro';
import ArticleModeSwitcher from '@/components/article/ArticleModeSwitcher.jsx';
import RelatedPostCardMobile from '@/components/article/RelatedPostCardMobile.astro';
import ArticleInfo from '@/components/article/ArticleInfo.astro';
import PostNavigation from '@/components/article/PostNavigation.astro';
import { generateBreadcrumbSchema } from '@/lib/structured-data/breadcrumb';

export async function getStaticPaths() {
    const allPosts = posts.filter(p => p.lang === 'id');
    return allPosts.map(post => ({
        params: { slug: post.path.replace('/blog/', '') },
        props: { post },
    }));
}

const { post } = Astro.props;
if (!post) {
    return Astro.redirect('/404');
}

const { metadata, Content, AuthorContent } = post;

// Helper function untuk memproses headings menjadi struktur bersarang untuk TOC
const processHeadingsToToc = (headings) => {
    const tocItems = [];
    let currentH2Group = null;
    headings.forEach((heading) => {
        if (heading.depth === 2) {
            currentH2Group = { text: heading.text, slug: heading.slug, level: 'h2', children: [] };
            tocItems.push(currentH2Group);
        } else if (heading.depth === 3 && currentH2Group) {
            currentH2Group.children.push({ text: heading.text, slug: heading.slug, level: 'h3' });
        }
    });
    return tocItems;
};

// Ambil dan proses headings untuk kedua mode
const standardHeadings = await post.getHeadings();
const standardTocItems = processHeadingsToToc(standardHeadings);

let authorTocItems = [];
if (post.getAuthorHeadings) {
    const authorHeadings = await post.getAuthorHeadings();
    authorTocItems = processHeadingsToToc(authorHeadings);
}

// Cari artikel terkait
const relatedPosts = posts
    .filter(p => p.metadata.category === metadata.category && p.path !== post.path)
    .slice(0, 2);


// Cari post sebelumnya dan sesudahnya untuk navigasi yang lebih kontekstual
// Sesuai panduan: prioritaskan subkategori, lalu kategori, lalu semua postingan.
let navigationScope = posts; // Default: semua postingan

if (metadata.subcategory) {
    const subcategoryPosts = posts.filter(p => 
        p.metadata.category === metadata.category && 
        p.metadata.subcategory === metadata.subcategory
    );
    // Gunakan scope subkategori jika ada lebih dari satu artikel di dalamnya
    if (subcategoryPosts.length > 1) {
        navigationScope = subcategoryPosts;
    } else {
        // Jika tidak, coba fallback ke scope kategori
        const categoryPosts = posts.filter(p => p.metadata.category === metadata.category);
        if (categoryPosts.length > 1) {
            navigationScope = categoryPosts;
        }
    }
} else {
    // Jika tidak ada subkategori, gunakan scope kategori
    const categoryPosts = posts.filter(p => p.metadata.category === metadata.category);
    if (categoryPosts.length > 1) {
        navigationScope = categoryPosts;
    }
}

// Cari index post saat ini di dalam scope navigasi yang sudah ditentukan
const currentPostIndex = navigationScope.findIndex(p => p.path === post.path);

// Dapatkan artikel "sebelumnya" (lebih baru) dan "selanjutnya" (lebih lama)
// Array 'posts' diurutkan dari yang terbaru ke yang terlama.
const prevPost = currentPostIndex > 0 ? navigationScope[currentPostIndex - 1] : null; // Artikel yang lebih baru
const nextPost = currentPostIndex < navigationScope.length - 1 ? navigationScope[currentPostIndex + 1] : null; // Artikel yang lebih lama

// Data untuk SEO
const canonicalUrl = new URL(post.path, Astro.site).href;
const imageUrl = new URL(metadata.thumbnail.src, Astro.site).href;

// Data untuk Breadcrumb Schema
const breadcrumbs = [
    { name: "Beranda", url: new URL('/', Astro.site).href },
    { name: "Blog", url: new URL('/blog', Astro.site).href },
    { name: "Kategori", url: new URL(`/blog/${metadata.category.toLowerCase().replace(/\s+/g, '-')}`, Astro.site).href },
];
if (metadata.subcategory) {
    breadcrumbs.push({
        name: metadata.subcategory,
        url: new URL(`/blog/${metadata.category.toLowerCase().replace(/\s+/g, '-')}/${metadata.subcategory.toLowerCase().replace(/\s+/g, '-')}`, Astro.site).href
    });
}
breadcrumbs.push({ name: metadata.title, url: canonicalUrl });
const breadcrumbSchemaData = generateBreadcrumbSchema(breadcrumbs);

---

<Layout
    title={metadata.title}
    description={metadata.metaDescription || metadata.description}
    image={imageUrl}
    canonical={canonicalUrl}
    type="article"
    author={metadata.author}
    publishDate={metadata.publishDate}
    lastUpdated={metadata.lastUpdated}
>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchemaData)} />



    <div class="mx-auto w-full max-w-[90rem] px-6 py-16 space-y-8">
        {/* Breadcrumbs */}
        <nav aria-label="Breadcrumb" class="text-sm text-gray-500 capitalize">
            <ol class="flex flex-wrap items-center space-x-2">
                <li><a href="/" class="hover:text-orange-500">Beranda</a></li>
                <li><span class="select-none">/</span></li>
                <li><a href="/blog" class="hover:text-orange-500">Blog</a></li>
                <li><span class="select-none">/</span></li>
                <li><a href={`/blog/${metadata.category.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-orange-500">{metadata.category}</a></li>
                {metadata.subcategory && (
                    <>
                        <li><span class="select-none">/</span></li>
                        <li><a href={`/blog/${metadata.category.toLowerCase().replace(/\s+/g, '-')}/${metadata.subcategory.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-orange-500">{metadata.subcategory}</a></li>
                    </>
                )}
                <li><span class="select-none">/</span></li>
                <li class="font-medium text-gray-800 line-clamp-1 normal-case">{metadata.title}</li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-3 lg:gap-12">
            {/* Main Content */}
            <div class="lg:col-span-2">
                <div class="rounded-lg bg-white p-4 sm:p-8 shadow-md">
                    <figure class="mb-8">
                        <div class="group relative" data-zoomable-image>
                            <Image
                                src={metadata.thumbnail}
                                alt={`Thumbnail for ${metadata.title}`}
                                width="800"
                                height="450"
                                format="webp"
                                class="w-full rounded-lg object-cover aspect-video"
                            />

                            <div class="absolute inset-0 flex cursor-zoom-in items-center justify-center rounded-lg bg-black/20 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                                <div class="rounded-full bg-white/80 p-4 shadow-lg backdrop-blur-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-8 w-8 text-gray-800">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                                    </svg>
                                </div>
                            </div>
                        </div>

                        {metadata.imageCaption && (
                            <figcaption class="mt-2 text-center text-sm italic text-gray-500">
                                {metadata.imageCaption}
                            </figcaption>
                        )}
                    </figure>

                    <header class="mb-8 border-b border-gray-200 pb-8">
                        <div class="mb-4 flex flex-wrap items-center gap-2">
                            <a href={`/blog/${metadata.category.toLowerCase().replace(/\s+/g, '-')}`} class="inline-block rounded-full bg-orange-100 px-3 py-1 text-sm font-semibold text-orange-800 transition-colors hover:bg-orange-200 capitalize">{metadata.category}</a>
                            {metadata.subcategory && (
                                <>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-gray-400"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
                                    <a href={`/blog/${metadata.category.toLowerCase().replace(/\s+/g, '-')}/${metadata.subcategory.toLowerCase().replace(/\s+/g, '-')}`} class="inline-block rounded-full bg-sky-100 px-3 py-1 text-sm font-semibold text-sky-800 transition-colors hover:bg-sky-200 capitalize">{metadata.subcategory}</a>
                                </>
                            )}
                            {metadata.contentType && (
                                <span class="inline-block rounded-full bg-green-100 px-3 py-1 text-sm font-semibold text-green-800 capitalize">{metadata.contentType}</span>
                            )}
                        </div>
                        <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-2 mb-4">{metadata.title}</h1>
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3">
                                <Image src={metadata.authorAvatar} alt={metadata.author} class="h-10 w-10 rounded-full" width={40} height={40} format="webp" />
                                <span class="font-semibold text-gray-800">{metadata.author}</span>
                            </div>
                            {/* Tampilkan switcher hanya jika ada konten Author's Style */}
                            {AuthorContent && (
                                <div class="not-prose">
                                    <ArticleModeSwitcher client:visible authorName={metadata.author} />
                                </div>
                            )}
                        </div>
                    </header>

                    {/* Mobile Table of Contents */}
                    {AuthorContent ? (
                        <>
                            {standardTocItems.length > 0 && (
                                <div class="my-8 border-t border-b border-gray-200 py-6 lg:hidden mode-formal">
                                    <TableOfContents client:visible items={standardTocItems} contentId="content-standard" />
                                </div>
                            )}
                            {authorTocItems.length > 0 && (
                                <div class="my-8 border-t border-b border-gray-200 py-6 lg:hidden mode-author">
                                    <TableOfContents client:visible items={authorTocItems} contentId="content-author" />
                                </div>
                            )}
                        </>
                    ) : (standardTocItems.length > 0 && <div class="my-8 border-t border-b border-gray-200 py-6 lg:hidden"><TableOfContents client:visible items={standardTocItems} /></div>)
                    }

                    <article class="prose lg:prose-lg max-w-none">
                        {/* Jika ada AuthorContent, tampilkan kedua mode dan biarkan CSS yang mengatur visibilitasnya */}
                        {AuthorContent ? (
                            <>
                                <div id="content-standard" class="mode-formal"><Content /></div>
                                <div id="content-author" class="mode-author"><AuthorContent /></div>
                            </>
                        ) : (
                            <Content /> // Jika tidak ada AuthorContent, tampilkan Content (Standard) secara langsung
                        )}
                    </article>
                    
                    {metadata.tags && metadata.tags.length > 0 && (
                        <div class="not-prose mt-12 border-t border-gray-200 pt-6">
                            <h3 class="text-lg font-bold text-gray-800 mb-4">Tags:</h3>
                            <div class="flex flex-wrap gap-2">{metadata.tags.map(tag => (<a href={`/blog/tag/${tag.toLowerCase()}`} class="rounded-full bg-orange-100 px-3 py-1 text-sm font-semibold text-orange-800 transition-colors hover:bg-orange-200 hover:shadow-sm">#{tag}</a>))}</div>
                        </div>
                    )}

                    {metadata.sources && metadata.sources.length > 0 && (
                        <div class="not-prose mt-8 border-t border-gray-200 pt-6">
                            <h3 class="text-lg font-bold text-gray-800 mb-4">Sumber Referensi:</h3>
                            <ul class="space-y-3">
                                {metadata.sources.map(source => (<li><a href={source.url} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 rounded-lg border border-gray-200 bg-gray-50 p-4 transition-all duration-200 hover:border-orange-300 hover:bg-orange-50 hover:shadow-sm">
                                    <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md bg-white shadow-sm ring-1 ring-gray-200">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-gray-500">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                                        </svg>
                                    </span>
                                    <div class="flex-1 min-w-0"><p class="font-semibold text-gray-800 group-hover:text-orange-600">{source.name}</p><p class="text-xs text-gray-500 truncate">{source.url}</p></div><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-gray-400 transition-transform group-hover:translate-x-1 self-center"><path fill-rule="evenodd" d="M2 10a.75.75 0 0 1 .75-.75h12.59l-2.1-1.95a.75.75 0 1 1 1.02-1.1l3.5 3.25a.75.75 0 0 1 0 1.1l-3.5 3.25a.75.75 0 1 1-1.02-1.1l2.1-1.95H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd" /></svg></a></li>))}
                            </ul>
                        </div>
                    )}
                </div>

                <div class="mt-12 space-y-8 lg:hidden">
                    <div class="rounded-lg bg-white p-6 shadow-md ring-1 ring-gray-100">
                        <h2 class="text-xl font-bold mb-4 border-b border-gray-200 pb-2">Postingan Lainnya</h2>
                        <ul class="space-y-4">{posts.filter(p => p.path !== post.path).slice(0, 5).map(p => (<li><a href={p.path} class="font-semibold text-gray-800 hover:text-orange-500 line-clamp-2">{p.metadata.title}</a><p class="text-xs text-gray-600">{new Date(p.metadata.publishDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long' })}</p></li>))}</ul>
                    </div>
                    <ArticleInfo metadata={metadata} />
                    <ShareButton client:visible />
                </div>

                {relatedPosts.length > 0 && (
                    <div class="mt-16">
                        <h2 class="text-3xl font-bold mb-6 border-b-4 border-orange-500 inline-block pb-1">Artikel Terkait</h2>
                        
                        {/* Tampilan Desktop: Kartu horizontal */}
                        <div class="hidden space-y-8 lg:block">
                            {relatedPosts.map(relatedPost => (<RelatedPostCard {...relatedPost.metadata} path={relatedPost.path} />))}
                        </div>

                        {/* Tampilan Mobile: Kartu vertikal dalam grid */}
                        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:hidden">
                            {relatedPosts.map(relatedPost => (<RelatedPostCardMobile {...relatedPost.metadata} path={relatedPost.path} />))}
                        </div>
                    </div>
                )}

                <PostNavigation prevPost={prevPost} nextPost={nextPost} />
            </div>

            {/* Sidebar */}
            <aside class="hidden lg:block lg:col-span-1">
                <div class="sticky top-40 flex flex-col gap-8">
                    <ShareButton client:visible />
                    {/* Desktop Table of Contents */}
                    {AuthorContent ? (
                        <>
                            <div class="mode-formal">
                                {standardTocItems.length > 0 && <TableOfContents client:visible items={standardTocItems} contentId="content-standard" />}
                            </div>
                            <div class="mode-author">
                                {authorTocItems.length > 0 && <TableOfContents client:visible items={authorTocItems} contentId="content-author" />}
                            </div>
                        </>
                    ) : (
                        standardTocItems.length > 0 && <TableOfContents client:visible items={standardTocItems} />
                    )}
                    <ArticleInfo metadata={metadata} />

                    <div class="rounded-lg bg-white p-6 shadow-md">
                        <h2 class="text-xl font-bold mb-4 border-b border-gray-200 pb-2">Postingan Lainnya</h2>
                        <ul class="space-y-4">{posts.filter(p => p.path !== post.path).slice(0, 5).map(p => (<li><a href={p.path} class="font-semibold text-gray-800 hover:text-orange-500 line-clamp-2">{p.metadata.title}</a><p class="text-xs text-gray-600">{new Date(p.metadata.publishDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long' })}</p></li>))}</ul>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</Layout>