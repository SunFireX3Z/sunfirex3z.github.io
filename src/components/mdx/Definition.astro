---
import DefinitionComponent from './Definition.jsx';
import type { ImageMetadata } from 'astro';

interface Props {
    className?: string;
    title?: string;
    description?: string;
    image?: ImageMetadata | string;
}

const { className, title, description, image } = Astro.props;
---
<DefinitionComponent
    className={className}
    title={title}
    description={description}
    image={image}
    client:visible
>
    <slot />
</DefinitionComponent>