---
const { 
    href, 
    imageSrc, 
    title, 
    price, 
    description 
} = Astro.props;

// Validasi props dasar untuk memastikan komponen ditampilkan dengan benar.
if (!href || !imageSrc || !title || !price) {
    console.error("Komponen ShopeeProduct memerlukan props 'href', 'imageSrc', 'title', and 'price'.");
}
---
<div class="not-prose my-8 rounded-xl border border-gray-200 bg-white shadow-lg overflow-hidden flex flex-col sm:flex-row">
    <div class="sm:w-1/3 flex-shrink-0 bg-gray-100 flex items-center justify-center">
        <a href={href} target="_blank" rel="noopener noreferrer nofollow" class="block w-full h-full">
            <img 
                src={typeof imageSrc === 'object' ? imageSrc.src : imageSrc} 
                alt={`Gambar produk ${title}`} 
                class="w-full h-48 sm:h-full object-contain p-4 transition-transform duration-300 hover:scale-105"
                loading="lazy"
                decoding="async"
            />
        </a>
    </div>
    <div class="flex flex-col justify-between p-6 sm:w-2/3">
        <div>
            <h4 class="text-lg font-bold text-gray-800 line-clamp-2">{title}</h4>
            {description && <p class="mt-2 text-sm text-gray-600 line-clamp-3">{description}</p>}
        </div>
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <p class="text-xl font-extrabold text-orange-600">{price}</p>
            <a 
                href={href} 
                target="_blank" 
                rel="noopener noreferrer nofollow"
                class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-lg bg-[#FF5722] px-6 py-3 text-base font-bold text-white shadow-md transition-all duration-300 hover:bg-[#F54D1A] hover:shadow-lg focus:outline-none focus:ring-4 focus:ring-orange-300"
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path d="M1 1.75A.75.75 0 0 1 1.75 1h1.628a1.75 1.75 0 0 1 1.734 1.51L5.18 3.5h11.25a.75.75 0 0 1 0 1.5H5.33l.25 1.5H15a.75.75 0 0 1 .75.75v5.5a.75.75 0 0 1-.75.75H8.25a.75.75 0 0 1 0-1.5h6V8H5.75a.75.75 0 0 1-.74-.63L3.34 1.99A.25.25 0 0 0 3.1 1H1.75A.75.75 0 0 1 1 1.75ZM6 17.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0ZM15.5 16a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z" /></svg>
                Beli di Shopee
            </a>
        </div>
    </div>
</div>

