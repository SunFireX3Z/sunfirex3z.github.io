---
import LinkPreviewComponent from './LinkPreview.jsx';
import type { ImageMetadata } from 'astro:assets';

interface Props {
    className?: string;
    title?: string;
    description?: string;
    image?: ImageMetadata | string;
}

const { className, title, description, image } = Astro.props;
---
<LinkPreviewComponent
    className={className}
    title={title}
    description={description}
    image={image}
    client:visible
>
    <slot />
</LinkPreviewComponent>