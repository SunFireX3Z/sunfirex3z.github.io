---
import { Image } from 'astro:assets';

const {
  src,
  alt,
  caption,
  class: className = "",
} = Astro.props;
---
<figure class="not-prose my-8 flex flex-col items-center">
  <Image
    src={src}
    alt={alt}
    class:list={[`w-full rounded-lg object-cover shadow-md`, className]}
    format="webp"
    quality={85}
  />
  {caption && (
    <figcaption class="mt-3 text-center text-sm italic text-gray-500">
      {caption}
    </figcaption>
  )}
</figure>