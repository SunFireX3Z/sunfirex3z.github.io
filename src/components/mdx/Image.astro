---
import { Image as AstroImage } from 'astro:assets';

const { 
    src, 
    alt, 
    caption, 
    className, // Ambil className dari props
    ...rest // Ambil sisa props untuk diteruskan ke AstroImage
} = Astro.props;
---
<figure class:list={["my-8 flex flex-col items-center", className]}>
    <AstroImage 
        src={src} 
        alt={alt} 
        class="w-full rounded-lg shadow-md"
        {...rest}
    />
    {caption && <figcaption class="mt-2 text-center text-sm italic text-gray-500">{caption}</figcaption>}
</figure>