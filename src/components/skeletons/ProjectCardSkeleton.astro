---
// Komponen ini meniru struktur visual dari `ProjectCard.astro`
// untuk digunakan sebagai placeholder saat data sedang dimuat.
---
<div class="flex h-full animate-pulse flex-col overflow-hidden rounded-xl bg-white shadow-md">
  <!-- Placeholder untuk Thumbnail -->
  <div class="aspect-video w-full flex-shrink-0 bg-gray-200"></div>
  
  <div class="flex flex-1 flex-col justify-between p-5">
    <div class="flex-1">
      <!-- Placeholder untuk Judul -->
      <div class="h-5 w-3/4 rounded bg-gray-200"></div>
      
      <!-- Placeholder untuk Deskripsi -->
      <div class="mt-3 space-y-2">
        <div class="h-4 w-full rounded bg-gray-200"></div>
        <div class="h-4 w-5/6 rounded bg-gray-200"></div>
        <div class="h-4 w-full rounded bg-gray-200"></div>
      </div>

      <!-- Placeholder untuk Tools -->
      <div class="mt-4 flex flex-wrap gap-2">
        <div class="h-6 w-20 rounded-full bg-gray-200"></div>
        <div class="h-6 w-24 rounded-full bg-gray-200"></div>
        <div class="h-6 w-16 rounded-full bg-gray-200"></div>
      </div>
    </div>
    <div class="mt-5 flex items-center justify-between gap-4 border-t border-gray-200 pt-4">
      <!-- Placeholder untuk Tanggal -->
      <div class="h-3 w-28 rounded bg-gray-200"></div>
      <!-- Placeholder untuk Tombol -->
      <div class="flex gap-3">
        <div class="h-9 w-20 rounded-md bg-gray-200"></div>
      </div>
    </div>
  </div>
</div>