---
// Komponen ini meniru struktur visual dari `Card.astro`
// untuk digunakan sebagai placeholder saat data sedang dimuat.
---
<div class="flex h-full animate-pulse flex-col overflow-hidden rounded-xl bg-white shadow-md">
  <!-- Placeholder untuk Thumbnail -->
  <div class="aspect-video w-full flex-shrink-0 bg-gray-200"></div>
  
  <div class="flex flex-1 flex-col justify-between p-3 sm:p-5">
    <div class="flex-1">
      <!-- Placeholder untuk Judul -->
      <div class="h-5 rounded bg-gray-200 sm:h-6 w-4/5"></div>
      
      <!-- Placeholder untuk Deskripsi -->
      <div class="mt-3 space-y-2 hidden sm:block">
        <div class="h-4 rounded bg-gray-200 w-full"></div>
        <div class="h-4 rounded bg-gray-200 w-5/6"></div>
      </div>
    </div>
    <div class="mt-4 flex items-center justify-between">
      <div class="flex items-center">
        <!-- Placeholder untuk Avatar -->
        <div class="h-6 w-6 rounded-full bg-gray-200 sm:h-8 sm:w-8"></div>
        <!-- Placeholder untuk Nama Penulis (hanya desktop) -->
        <div class="ml-2 hidden h-4 w-24 rounded bg-gray-200 sm:ml-3 sm:block"></div>
      </div>
      <!-- Placeholder untuk Tanggal -->
      <div class="h-3 w-20 rounded bg-gray-200"></div>
    </div>
  </div>
</div>