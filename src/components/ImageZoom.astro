---
// This component provides a global image zoom (lightbox) functionality.
// It should be placed once in your main Layout.astro file.
---

<div id="image-zoom-modal" class="fixed inset-0 z-50 flex cursor-zoom-out items-center justify-center bg-black/80 p-8 sm:p-16 opacity-0 invisible transition-opacity duration-300" aria-hidden="true" role="dialog">
    <button id="image-zoom-close-button" class="absolute top-4 right-4 z-10 rounded-full bg-white/20 p-2 text-white transition-colors hover:bg-white/40" aria-label="Tutup gambar">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-6 w-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
    </button>
    <img id="image-zoom-content" src="" alt="Gambar yang diperbesar" class="max-h-full max-w-full rounded-lg object-contain shadow-[0_0_40px_rgba(249,115,22,0.18)] transition-all duration-300 scale-95 opacity-0" />
</div>

<script>
    // Fungsi ini akan dijalankan sekali dan akan mengatur semua event listener,
    // termasuk yang untuk menangani konten yang dimuat secara dinamis oleh Astro.
    function initializeImageZoom() {
        const modal = document.getElementById('image-zoom-modal');
        const modalImage = document.getElementById('image-zoom-content');
        const closeButton = document.getElementById('image-zoom-close-button');

        if (!modal || !modalImage) return;

        // --- Fungsi untuk membuka dan menutup modal ---
        const openModal = (imageUrl) => {
            modalImage.setAttribute('src', imageUrl);
            modal.classList.remove('invisible', 'opacity-0');
            modalImage.classList.remove('scale-95', 'opacity-0'); // Animate in
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        };

        const closeModal = () => {
            modal.classList.add('invisible', 'opacity-0');
            modalImage.classList.add('scale-95', 'opacity-0'); // Animate out
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            setTimeout(() => modalImage.setAttribute('src', ''), 300); // Clear src after transition
        };

        // --- Menangani event klik pada gambar yang bisa di-zoom ---
        const attachZoomEvents = (container) => {
            const zoomableElements = container.querySelectorAll('[data-zoomable-image]');
            zoomableElements.forEach(element => {
                // Mencegah listener ganda jika skrip dijalankan lagi
                if (element.dataset.zoomListenerAttached) return;

                element.addEventListener('click', (event) => {
                    event.preventDefault();
                    event.stopPropagation();

                    const imageElement = element.querySelector('img');
                    if (imageElement) {
                        openModal(imageElement.src);
                    }
                });

                element.dataset.zoomListenerAttached = 'true';
            });
        };

        // --- Event listener global untuk menutup modal ---
        modal.addEventListener('click', closeModal);

        if (closeButton) {
            closeButton.addEventListener('click', (event) => {
                event.stopPropagation(); // Hentikan event agar tidak trigger click pada modal
                closeModal();
            });
        }

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closeModal();
            }
        });

        // --- Inisialisasi dan penanganan konten dinamis ---
        // 1. Jalankan saat halaman pertama kali dimuat
        attachZoomEvents(document.body);

        // 2. Gunakan MutationObserver untuk mendeteksi perubahan halaman oleh Astro (View Transitions)
        const observer = new MutationObserver((mutations) => {
            mutations.forEach(mutation => {
                mutation.addedNodes.forEach(node => {
                    if (node.nodeType === 1) { // Hanya proses Element nodes
                        attachZoomEvents(node);
                    }
                });
            });
        });

        // Mulai mengamati perubahan pada seluruh body
        observer.observe(document.body, { childList: true, subtree: true });
    }

    // Jalankan fungsi inisialisasi setelah DOM siap
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeImageZoom);
    } else {
        initializeImageZoom();
    }
</script>