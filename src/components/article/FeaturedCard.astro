---
import { ARTICLE_THUMBNAIL_DEFAULTS } from '@/config';
const { path, title, thumbnail, publishDate, description, author, authorAvatar } = Astro.props;

let thumbSrc, thumbWidth, thumbHeight;
if (typeof thumbnail === 'object' && thumbnail !== null && 'src' in thumbnail) {
    thumbSrc = thumbnail.src;
    thumbWidth = thumbnail.width;
    thumbHeight = thumbnail.height;
} else {
    thumbSrc = thumbnail;
    thumbWidth = ARTICLE_THUMBNAIL_DEFAULTS.width;
    thumbHeight = ARTICLE_THUMBNAIL_DEFAULTS.height;
}

const avatarSrc = typeof authorAvatar === 'object' && authorAvatar !== null ? authorAvatar.src : authorAvatar;
---
<a href={path} class="group flex flex-col sm:flex-row items-start gap-4 rounded-lg transition-colors hover:bg-gray-50">
  <div class="relative w-full sm:w-60 flex-shrink-0">
    <img class="w-full aspect-video rounded-lg object-cover"
         src={thumbSrc} alt={`Thumbnail for ${title}`}
         width={thumbWidth} height={thumbHeight}
         loading="lazy" decoding="async" />
  </div>
  <div class="flex flex-1 flex-col">
    <div>
      <h3 class="line-clamp-2 text-base font-bold text-gray-900 group-hover:text-orange-600">
        {title}
      </h3>
      <p class="mt-1 text-sm text-gray-500 line-clamp-2">{description}</p>
    </div>
    <div class="mt-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <img class="h-8 w-8 rounded-full object-cover"
             src={avatarSrc} alt={`Avatar of ${author}`}
             width={32} height={32}
             loading="lazy" decoding="async" />
        <p class="text-sm font-bold text-gray-900">{author}</p>
      </div>
      <p class="text-xs text-gray-500">{new Date(publishDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
    </div>
  </div>
</a>