---
const { path, title, description, thumbnail, author, authorAvatar, publishDate } = Astro.props;
---
<a href={path} class="group flex h-full flex-col overflow-hidden rounded-xl bg-white shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg">
  <div class="relative flex-shrink-0 overflow-hidden">
    <img class="w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] aspect-video" src={thumbnail.src} alt={`Thumbnail for ${title}`} />
  </div>
  <div class="flex flex-1 flex-col justify-between p-4">
    <div class="flex-1">
        <h2 class="text-base font-bold text-gray-900 group-hover:text-orange-600 line-clamp-2">
          {title}
        </h2>
        <p class="mt-2 text-sm text-gray-500 line-clamp-2">
          {description}
        </p>
    </div>
    <div class="mt-4 flex items-center">
        <img class="h-8 w-8 rounded-full object-cover" src={authorAvatar.src} alt={`Avatar of ${author}`} />
        <div class="ml-3 text-xs">
            <p class="font-bold text-gray-900">{author}</p>
            <p class="text-gray-500">{new Date(publishDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
        </div>
    </div>
  </div>
</a>