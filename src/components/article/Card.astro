---
import { ARTICLE_THUMBNAIL_DEFAULTS } from '@/config';
const { path, title, description, author, publishDate, thumbnail, authorAvatar, isLarge = false } = Astro.props;

let thumbSrc, thumbWidth, thumbHeight;
if (typeof thumbnail === 'object' && thumbnail !== null && 'src' in thumbnail) {
    thumbSrc = thumbnail.src;
    thumbWidth = thumbnail.width;
    thumbHeight = thumbnail.height;
} else {
    thumbSrc = thumbnail;
    thumbWidth = ARTICLE_THUMBNAIL_DEFAULTS.width;
    thumbHeight = ARTICLE_THUMBNAIL_DEFAULTS.height;
}

const avatarSrc = typeof authorAvatar === 'object' && authorAvatar !== null ? authorAvatar.src : authorAvatar;
---
<a href={path} class="group flex h-full flex-col overflow-hidden rounded-xl bg-white shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg">
  <div class="relative flex-shrink-0 overflow-hidden">
    <img
        src={thumbSrc} alt={`Thumbnail for ${title}`}
        width={thumbWidth} height={thumbHeight}
        class="w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] aspect-video"
        loading="lazy" decoding="async"
    />
  </div>
  <div class="flex flex-1 flex-col justify-between p-3 sm:p-5">
    <div class="flex-1">
        <h2 class="text-base font-bold leading-tight text-gray-900 group-hover:text-orange-600 sm:text-lg line-clamp-2">
          {title}
        </h2>
        <p class:list={["mt-2 text-sm text-gray-500 hidden sm:block", isLarge ? 'line-clamp-3' : 'line-clamp-2']}>
          {description}
        </p>
    </div>
    <div class="mt-4 flex items-center justify-between">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <img
              src={avatarSrc} alt={`Avatar of ${author}`}
              class="h-6 w-6 rounded-full object-cover sm:h-8 sm:w-8"
              width={32} height={32}
              loading="lazy" decoding="async"
          />
        </div>
        <div class="ml-2 hidden sm:ml-3 sm:block">
          <p class="text-sm font-bold text-gray-900">{author}</p>
        </div>
      </div>
      <p class="text-xs text-gray-600">{new Date(publishDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
    </div>
  </div>
</a>