---
import Layout from '@/layouts/Layout.astro';
import Card from '@/components/article/Card.astro';
import CategoryNavLink from '@/components/article/CategoryNavLink.astro';
import Pagination from '@/components/article/Pagination.astro';
import CardSkeleton from '@/components/skeletons/CardSkeleton.astro';
import { posts } from '@/data/posts';

const { pageTitle, pageDescription, filteredPosts, page } = Astro.props;
const currentPath = Astro.url.pathname;

// Atur jumlah skeleton yang akan ditampilkan, sesuaikan dengan pageSize pada paginasi
const SKELETON_PAGE_SIZE = 12;

// Ambil semua kategori unik dari postingan untuk navigasi
const totalPostCount = posts.length;
const categoryCounts = posts.reduce((acc, post) => {
    const category = post.category;
    acc[category] = (acc[category] || 0) + 1;
    return acc;
}, {});

const categoriesWithCounts = [
    { name: 'Semua', count: totalPostCount, path: '/blog' },
    ...Object.entries(categoryCounts).map(([name, count]) => ({
        name,
        count,
        path: `/blog/${name.toLowerCase().replace(/\s+/g, '-')}`
    }))
];
---
<Layout title={pageTitle} description={pageDescription}>

    <div class="mx-auto w-full max-w-[90rem] px-6 space-y-12 py-16">
        <section class="border-l-4 border-orange-500 pl-4">
            <h1 class="text-4xl font-bold tracking-tight lg:text-5xl capitalize">{pageTitle}</h1>
            <p class="mt-4 max-w-2xl text-lg text-gray-600">{pageDescription}</p>
        </section>

        {/* Filter Kategori */}
        <nav class="flex gap-3 overflow-x-auto pb-4 horizontal-scrollbar">
            {categoriesWithCounts.map(cat => (
                <CategoryNavLink href={cat.path} currentPath={currentPath} text={cat.name} count={cat.count} class="flex-shrink-0" />
            ))}
        </nav>

        <section>
            {filteredPosts.length > 0 ? (
                <div>
                    <div class="grid grid-cols-2 gap-4 md:grid-cols-2 md:gap-8 lg:grid-cols-3 xl:grid-cols-4">
                        {filteredPosts.map((post) => (<Card {...post.metadata} path={post.path} />))}
                    </div>
                </div>
            ) : (
                <div class="text-center py-16">
                    <h2 class="text-2xl font-bold text-gray-700">Oops! Tidak Ada Postingan</h2>
                    <p class="mt-2 text-gray-500">Sepertinya tidak ada artikel yang cocok dengan kriteria ini.</p>
                    <a href="/blog" class="mt-6 inline-block rounded-lg bg-orange-600 px-6 py-3 font-bold text-white shadow-lg transition-all hover:bg-orange-700">Kembali ke Semua Postingan</a>
                </div>
            )}

            <!-- Tampilkan kontrol paginasi jika objek 'page' ada -->
            {page && <Pagination page={page} />}
        </section>
    </div>
</Layout>