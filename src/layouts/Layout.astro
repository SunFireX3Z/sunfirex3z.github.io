---
import { getImage } from 'astro:assets';
import Header from "@/components/article/Header.jsx";
import Footer from "@/components/article/Footer.astro";
import SEO from "@/components/article/SEO.astro";
import { posts } from "@/data/posts";
import ImageZoom from '@/components/ImageZoom.astro';
import GoogleAnalytics from '@/components/article/GoogleAnalytics.astro';

import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    type?: "website" | "article";
}

const {
    title,
    description,
    image,
    type,
} = Astro.props as Props;

const currentPath = Astro.url.pathname;

// Optimalkan gambar thumbnail untuk komponen Header (pencarian)
const postsForHeader = await Promise.all(
    posts.map(async (post) => {
        if (!post.metadata.thumbnail) return post;
        const { src } = await getImage({
            src: post.metadata.thumbnail,
            width: 80, // Lebar thumbnail di hasil pencarian
            format: 'webp',
            quality: 75,
        });
        return { ...post, optimizedThumbnailSrc: src };
    })
);
---

<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <SEO
            title={title}
            description={description}
            image={image}
            type={type}
        />

        {/* Google Analytics Script */}
        <GoogleAnalytics />

        <slot name="head" />
    </head>

    <body class="min-h-screen bg-slate-50 text-slate-800 flex flex-col">
        <Header
            client:load
            currentPath={currentPath}
            posts={postsForHeader}
        />

        <main class="mx-auto flex-1 w-full max-w-[90rem] px-6 py-12">
            <slot />
        </main>

        <Footer />
        <ImageZoom />
    </body>
</html>